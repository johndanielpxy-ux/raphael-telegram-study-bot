{
  "name": "raphael-telegram-study-bot",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "pretest": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "import:cards": "tsx scripts/import-cards.ts",
    "telegram:setup": "tsx scripts/configure-telegram.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": { "ts-fsrs": "5.4.2" },
  "overrides": { "sharp": "0.35.5" },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "miniflare": "5.20261001.0-alpha",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.147.0"
  }
}
